rl":"/bootcamp/full-stack-java-ai-ml-developer-bootcamp","MobileBanner":"https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/fullstackjavaaimldeveloperbootcamp-mobile.png","FooterDetails":"<ul class=\"job-description\">\r\n    <li>Backend Development with Java, MySQL, Spring MVC and REST API</li>\r\n    <li>Modern Full-stack Development with React, Angular, AWS Cloud and AI/ML</li>\r\n    <li>200+ Hands-on Labs, Quick Notes, Skill Tests &amp; Interview Q&amp;A</li>\r\n    <li>Build 6 Real-World Industry Projects</li>\r\n</ul>","SmallBanner":"https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/fullstackjavagenaideveloperbootcamp-small.jpg","VideoCount":0,"ProjectCount":6,"Duration":"30:00:00","Paths":null},{"Id":1470,"Name":"Java AI/ML Architect Bootcamp","TagLine":"Master Java, MySQL, Spring MVC, Angular, React, AWS Cloud & Spring AI","CourseCount":0,"Url":"/bootcamp/java-ai-ml-architect-bootcamp","MobileBanner":"https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/javaaimlarchitectbootcamp-mobile.png","FooterDetails":"<ul class=\"job-description\">\r\n    <li>Backend Development with Java, MySQL, Spring MVC and REST API</li>\r\n    <li>Modern Full-stack Development with React, Angular, AWS Cloud and AI/ML</li>\r\n    <li>200+ Hands-on Labs, Quick Notes, Skill Tests &amp; Interview Q&amp;A</li>\r\n    <li>Build 6 Real-World Industry Projects</li>\r\n</ul>","SmallBanner":"https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/javaaimlarchitectbootcamp-small.jpg","VideoCount":0,"ProjectCount":6,"Duration":"30:00:00","Paths":null}],"JavaScript":[{"Id":1448,"Name":"Full-Stack JavaScript AI/ML Developer Bootcamp","TagLine":"Master JavaScript, MongoDB, Node.js, Angular, React, AWS Cloud & AI","CourseCount":0,"Url":"/bootcamp/full-stack-javascript-ai-ml-developer-bootcamp","MobileBanner":"https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/fullstackjavascriptaimldeveloperbootcamp-mobile.png","FooterDetails":"<ul class=\"job-description\">\r\n    <li>Backend Development with JavaScript, MongoDB, Node.js and REST API</li>\r\n    <li>Modern Full-stack Development with React, Angular, AWS Cloud and AI/ML</li>\r\n    <li>200+ Hands-on Labs, Quick Notes, Skill Tests &amp; Interview Q&amp;A</li>\r\n    <li>Build 6 Real-World Industry Projects</li>\r\n</ul>","SmallBanner":"https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/fullstackjavascriptaimldeveloperbootcamp-small.jpg","VideoCount":0,"ProjectCount":6,"Duration":"30:00:00","Paths":null}]};</script><script src=https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js></script><div class="d-none d-lg-flex justify-content-center gap-xl-2"><div class=live-training-dropdown style=margin-top:6px><a class=tutorial-button> <span class="font-medium text-sm"> Our Courses</span> <svg class=live-training-chevron xmlns=http://www.w3.org/2000/svg width=24 height=24 viewBox="0 0 24 24" fill=none stroke=currentColor stroke-width=2 stroke-linecap=round stroke-linejoin=round><polyline points="6 9 12 15 18 9"></polyline></svg> </a><div class=live-training-menu><div class=live-training-flex><div class=live-training-sidebar><a style=text-decoration:none href=/courses> <button type=button class="btn btn-outline-primary w-100 mb-4 fw-medium rounded-pill shadow-sm hover-shadow-lg transition-all duration-300" style=font-size:15px> All Courses </button> </a><h3 class=live-training-categories-title>Course Categories</h3><div class=live-training-categories><button class="live-training-category-btn category-list" data-category=".NET Platform  "> <img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/netplatform-mobile.png class="me-2 icon-invert-on-hover" width=24 height=24 alt=".NET Platform  "> <span class=live-training-category-text>.NET Platform </span> </button> <button class="live-training-category-btn category-list" data-category=AI/ML> <img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/aiml-mobile.png class="me-2 icon-invert-on-hover" width=24 height=24 alt=AI/ML> <span class=live-training-category-text>AI/ML</span> </button> <button class="live-training-category-btn category-list" data-category="Career &amp; Leadership"> <img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/careerleadership-mobile.png class="me-2 icon-invert-on-hover" width=24 height=24 alt="Career &amp; Leadership"> <span class=live-training-category-text>Career &amp; Leadership</span> </button> <button class="live-training-category-btn category-list" data-category="Cloud &amp; DevOps "> <img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/devops-mobile.png class="me-2 icon-invert-on-hover" width=24 height=24 alt="Cloud &amp; DevOps "> <span class=live-training-category-text>Cloud &amp; DevOps </span> </button> <button class="live-training-category-btn category-list" data-category=Databases> <img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/databases-mobile.png class="me-2 icon-invert-on-hover" width=24 height=24 alt=Databases> <span class=live-training-category-text>Databases</span> </button> <button class="live-training-category-btn category-list" data-category="Java Platform"> <img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/javaplatform-mobile.png class="me-2 icon-invert-on-hover" width=24 height=24 alt="Java Platform"> <span class=live-training-category-text>Java Platform</span> </button> <button class="live-training-category-btn category-list" data-category="JS &amp; Frontend "> <img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/jsfrontend-mobile.png class="me-2 icon-invert-on-hover" width=24 height=24 alt="JS &amp; Frontend "> <span class=live-training-category-text>JS &amp; Frontend </span> </button></div></div><div class="live-training-main category-course-container"><div class=live-training-header><h3 class="live-training-title category-title">Category Name</h3><p class=live-training-subtitle>Courses by Industry Experts</div><div class="live-training-courses category-course-list"><a href=/course/dotnet-csharp-programming class=live-training-course><div class="dis-flex align-items-center gap-2 w-full"><div class=live-training-icon><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/csharpwithnet-mobile.png alt=".NET &amp; C# Programming Course"></div><div class=live-training-course-content><h5 class=live-training-course-title>.NET &amp; C# Programming Course</h5><p class=live-training-course-desc>Master .NET, C#, OOPs &amp; Advanced C# with Labs &amp; Q&amp;A</div></div></a> <a href=/course/dotnet-microservices-course class=live-training-course><div class="dis-flex align-items-center gap-2 w-full"><div class=live-training-icon><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/netmicroservicescourse-mobile.png alt=".NET Microservices Course with Project"></div><div class=live-training-course-content><h5 class=live-training-course-title>.NET Microservices Course with Project</h5><p class=live-training-course-desc>Master Microservices Patterns with Project, Labs &amp; Q&amp;A</div></div></a> <a href=/course/net-system-design-and-design-pattern-course class=live-training-course><div class="dis-flex align-items-center gap-2 w-full"><div class=live-training-icon><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/systemdesigndesignpatterncourse-mobile.png alt=".NET System Design &amp; Design Patterns Course with Project"></div><div class=live-training-course-content><h5 class=live-training-course-title>.NET System Design &amp; Design Patterns Course with Project</h5><p class=live-training-course-desc>Design Smarter. Build Scalable Systems.</div></div></a> <a href=/course/aspnet-core-webapi-course class=live-training-course><div class="dis-flex align-items-center gap-2 w-full"><div class=live-training-icon><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/aspnetcorecourse-mobile.png alt="ASP.NET Core &amp; Web API Course with Project"></div><div class=live-training-course-content><h5 class=live-training-course-title>ASP.NET Core &amp; Web API Course with Project</h5><p class=live-training-course-desc>Master ASP.NET Core, Web API with Project, Labs &amp; Q&amp;A</div></div></a> <a href=/course/machine-learning-with-ml-net-csharp class=live-training-course><div class="dis-flex align-items-center gap-2 w-full"><div class=live-training-icon><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/mlnet-mobile.png alt="Machine Learning with ML.NET &amp; C# Course"></div><div class=live-training-course-content><h5 class=live-training-course-title>Machine Learning with ML.NET &amp; C# Course</h5><p class=live-training-course-desc>Build &amp; Integrate ML Models with Projects, Labs &amp; Q&amp;A</div></div></a></div><div class=live-training-cta><div class="dis-flex align-items-center justify-content-between"><div><h4 class=live-training-cta-header>Learn at Your Own Pace</h4><p class=live-training-cta-text>Learn anytime with self-paced courses</div><a href=/courses class=live-training-join-btn>Start Learning</a></div></div></div></div></div></div><script>$(function(){const $liveTrainingContainer=$('.live-training-dropdown .category-course-container');const $liveTrainingList=$liveTrainingContainer.find('.category-course-list');const categoryTitle=$liveTrainingContainer.find('.category-title');const $categoryList=$('.live-training-dropdown .category-list');if($categoryList.length>0){$categoryList.first().addClass('active-category');const initialCategory=$categoryList.first().data('category');categoryTitle.text(initialCategory);populateCategoryLiveTraining(initialCategory);}
$categoryList.on('mouseenter',function(){$categoryList.removeClass('active-category');$(this).addClass('active-category');const category=$(this).data('category');categoryTitle.text(category);populateCategoryLiveTraining(category);});function populateCategoryLiveTraining(category){let html='';if(main_menu[category]&&Array.isArray(main_menu[category])){main_menu[category].forEach(course=>{html+=`

                <a href="${course.Url}" class="live-training-course">

                <div class="dis-flex align-items-center gap-2 w-full">

                <div class="live-training-icon">

                <img src="${course.MobileBanner}" alt="${course.Name}" />

                </div>

                <div class="live-training-course-content">

                <h5 class="live-training-course-title">${course.Name}</h5>

                <p class="live-training-course-desc">${course.TagLine ?? ""}</p>

                </div>

                </div>

                </a>`;});}
$liveTrainingList.html(html);}
const $jobTrainingContainer=$('.job-training-dropdown .job-category-course-container');const $jobTrainingList=$jobTrainingContainer.find('.job-category-course-list');const jobCategoryTitle=$jobTrainingContainer.find('.job-category-title');const $jobCategoryList=$('.job-training-dropdown .job-category-list');if($jobCategoryList.length>0){$jobCategoryList.first().addClass('active-category');const initialCategory=$jobCategoryList.first().data('category');jobCategoryTitle.text(initialCategory);populateJobOrientedCourses(initialCategory);}
$jobCategoryList.on('mouseenter',function(){$jobCategoryList.removeClass('active-category');$(this).addClass('active-category');const category=$(this).data('category');jobCategoryTitle.text(category);populateJobOrientedCourses(category);});function populateJobOrientedCourses(category){let html='';if(json_main_menu[category]&&Array.isArray(json_main_menu[category])){json_main_menu[category].forEach(course=>{html+=`

                <a href="${course.Url}" class="job-training-course">

                <div class="dis-flex align-items-center gap-2 w-full">

                <div class="job-training-icon">

                <img src="${course.MobileBanner}" alt="${course.Name}" />

                </div>

                <div class="job-training-course-content">

                <h5 class="job-training-course-title">${course.Name}</h5>

                <p class="job-training-course-desc">${course.TagLine ?? ""}</p>

                </div>

                </div>

                </a>`;});}
$jobTrainingList.html(html);}
let sandboxHtml='';if(sandbox_menu&&sandbox_menu.length>0){sandbox_menu.forEach(item=>{sandboxHtml+=`

                <a href="${item.Url}" class="sandbox-item">

                <div class="d-flex align-items-center gap-2">

                <img src="${item.Logo}" style="width:28px;height:28px"/>

                <div style="display:flex; flex-direction:column;">

                <span class="sandbox-title">${item.Name}</span>

                <small class="sandbox-sub">Access full sandbox</small>

                </div>

                </div>

                </a>`;});}
$('#sandbox-list').html(sandboxHtml);function toSlug(text){return text.toLowerCase().replace(/&/g,'and').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');}
let skillHtml='';if(skill_categories&&skill_categories.length>0){skill_categories.forEach(item=>{skillHtml+=`

                <a href="/skill-tests/${toSlug(item.CourseCategoryName)}" class="sandbox-item">

                <div class="d-flex align-items-center gap-2 w-full">

                <div class="job-training-icon">

                <img src="${item.MobileBanner}" alt="${item.CourseCategoryName}"  />

                </div>

                <div class="d-flex flex-column">

                <span class="sandbox-title">${item.CourseCategoryName}</span>

                <small class="sandbox-sub">Take test</small>

                </div>

                </div>

                </a>`;});}
$('#skill-test-list').html(skillHtml);$(document).on('click','.dsa-item',function(){$('.dsa-item').removeClass('active-dsa');$(this).addClass('active-dsa');});let compilers=[{name:"C",icon:"/images/icons/Cm.svg",url:"/compiler/c"},{name:"C++",icon:"/images/icons/cplusM.svg",url:"/compiler/cpp"},{name:"C#",icon:"/images/icons/csharpM.svg",url:"/compiler/csharp"},{name:"Java",icon:"/images/icons/javaM.svg",url:"/compiler/java"},{name:"Python",icon:"/images/icons/pythonM.svg",url:"/compiler/python"},{name:"JavaScript",icon:"/images/icons/javascriptM.svg",url:"/compiler/javascript"},{name:"TypeScript",icon:"/images/icons/typescriptM.svg",url:"/compiler/typescript"},{name:"HTML",icon:"/images/icons/htmlM.svg",url:"/compiler/html"},{name:"Angular",icon:"/images/icons/angularM.svg",url:"/compiler/angular"},{name:"React",icon:"/images/icons/reactM.svg",url:"/compiler/react"}];let compilerHtml='';compilers.forEach(item=>{compilerHtml+=`

                <a href="${item.url}" class="sandbox-item">

                <div class="d-flex align-items-center gap-2">

                <img src="${item.icon}" style="width:28px;height:28px" />

                <div style="display:flex; flex-direction:column;">

                <span class="sandbox-title">${item.name}</span>

                <small class="sandbox-sub">Run code</small>

                </div>

                </div>

                </a>`;});$('#compiler-list').html(compilerHtml);$('#potd-redirect').on('click',function(e){e.preventDefault();$.ajax({url:'/api/problems/problem-of-the-day',method:'GET',success:function(response){window.location.href=response?.Problem?.Url||'/problems';},error:function(){window.location.href='/problems';}});});});$(document).ready(function(){const $bootcampRoot=$('.job-training-dropdown.bootcamp');const $bootcampContainer=$bootcampRoot.find('.bootcamp-category-course-container');const $bootcampList=$bootcampContainer.find('.bootcamp-category-course-list');const bootcampTitle=$bootcampContainer.find('.job-category-title');const $bootcampCategoryList=$bootcampRoot.find('.bootcamp-category-list');if($bootcampCategoryList.length>0){$bootcampCategoryList.first().addClass('active-category');const initialCategory=$bootcampCategoryList.first().data('category');bootcampTitle.text(initialCategory);populateBootcampCourses(initialCategory);}
$bootcampCategoryList.on('mouseenter',function(){$bootcampCategoryList.removeClass('active-category');$(this).addClass('active-category');const category=$(this).data('category');bootcampTitle.text(category);populateBootcampCourses(category);});function populateBootcampCourses(category){let html='';if(json_bootcamp_menu&&json_bootcamp_menu[category]){json_bootcamp_menu[category].forEach(course=>{html+=`

                <a href="${course.Url}" class="job-training-course">

                <div class="dis-flex align-items-center gap-2 w-full">



                <div class="job-training-icon">

                <img width="24" height="24" src="${course.MobileBanner}" />

                </div>



                <div class="job-training-course-content">

                <h5 class="job-training-course-title">${course.Name}</h5>

                <p class="job-training-course-desc">${course.TagLine ?? ""}</p>

                </div>



                </div>

                </a>`;});}
$bootcampList.html(html);}});</script><div class="job-training-dropdown bootcamp" style=margin-top:6px><a class=tutorial-button> <span class="font-medium text-sm">Bootcamps</span> <svg class=job-training-chevron xmlns=http://www.w3.org/2000/svg width=24 height=24 viewBox="0 0 24 24" fill=none stroke=currentColor stroke-width=2 stroke-linecap=round stroke-linejoin=round><polyline points="6 9 12 15 18 9"></polyline></svg> </a><div class=job-training-menu><div class=job-training-flex><div class=job-training-sidebar><a style=text-decoration:none href=/bootcamp> <button class="btn btn-outline-primary w-100 mb-4 fw-medium rounded-pill shadow-sm"> All Bootcamps </button> </a><h3 class=job-training-categories-title>Bootcamp Categories</h3><div class=job-training-categories><button class="job-training-category-btn bootcamp-category-list" data-category=.NET> <img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/netplatform-mobile.png class="me-2 icon-invert-on-hover" width=24 height=24> <span class=live-training-category-text> .NET </span> </button> <button class="job-training-category-btn bootcamp-category-list" data-category=AI/ML> <img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/aimlagenticai-mobile.png class="me-2 icon-invert-on-hover" width=24 height=24> <span class=live-training-category-text> AI/ML </span> </button> <button class="job-training-category-btn bootcamp-category-list" data-category=Java> <img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/java-mobile.png class="me-2 icon-invert-on-hover" width=24 height=24> <span class=live-training-category-text> Java </span> </button> <button class="job-training-category-btn bootcamp-category-list" data-category=JavaScript> <img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/javascript-mobile.png class="me-2 icon-invert-on-hover" width=24 height=24> <span class=live-training-category-text> JavaScript </span> </button></div></div><div class="job-training-main bootcamp-category-course-container"><div class=job-training-header><h3 class="job-category-title job-training-title">.NET</h3><p class=job-training-subtitle>Intensive career-focused programs</div><div class="job-training-courses bootcamp-category-course-list"><a href=/bootcamp/net-ai-ml-architect-bootcamp class=job-training-course><div class="dis-flex align-items-center gap-2 w-full"><div class=job-training-icon><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/netaimlarchitectbootcamp-mobile.png></div><div class=job-training-course-content><h5 class=job-training-course-title>.NET AI/ML Architect Bootcamp</h5><p class=job-training-course-desc>Master Software Architecture, System Design, Microservices, Docker/K8s &amp; ML.NET</div></div></a> <a href=/bootcamp/full-stack-net-ai-ml-developer-bootcamp class=job-training-course><div class="dis-flex align-items-center gap-2 w-full"><div class=job-training-icon><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/fullstacknetaimldeveloperbootcamp-mobile.png></div><div class=job-training-course-content><h5 class=job-training-course-title>Full-Stack .NET AI/ML Developer Bootcamp</h5><p class=job-training-course-desc>Master C#, SQL Server, ASP.NET Core, Angular, React, Azure Cloud &amp; AI/ML.NET</div></div></a> <a href=/bootcamp/multi-cloud-net-ai-agentic-ai-architect-bootcamp class=job-training-course><div class="dis-flex align-items-center gap-2 w-full"><div class=job-training-icon><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/multicloudnetaiaiagentsdeveloperbootcamp-mobile.png></div><div class=job-training-course-content><h5 class=job-training-course-title>Multi-Cloud .NET AI &amp; Agentic AI Architect Bootcamp</h5><p class=job-training-course-desc>Master Python, ML.NET, Azure AI, AWS AI, GenAI, AI Agents, Claude &amp; ChatGPT</div></div></a></div><div class=job-training-cta><div class="dis-flex al