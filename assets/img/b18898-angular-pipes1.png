amp <i class="bi bi-arrow-right" aria-hidden=true></i></span> </span> </a></div></div></div></div><div class=jr-all><a href=/bootcamp>Explore all bootcamps <i class="bi bi-arrow-up-right" aria-hidden=true></i></a></div></div></section><script>(function(){var root=document.getElementById("job-roadmap");if(!root)return;var calm=matchMedia("(prefers-reduced-motion: reduce)").matches;var path=document.getElementById("jr-path"),svg=path.querySelector(".jr-wave"),base=svg.querySelector(".base"),prog=svg.querySelector(".prog"),dot=svg.querySelector(".dot");var lis=[].slice.call(path.querySelectorAll("li")),roles=[].slice.call(path.querySelectorAll(".jr-role")),nodes=[].slice.call(path.querySelectorAll(".jr-node"));var at=0,hold=false,timer,raf,len=0,fr=[],cur=0,started=false;function layout(){var ol=path.querySelector(".jr-nodes");svg.setAttribute("viewBox","0 0 "+path.offsetWidth+" "+path.offsetHeight);var pts=nodes.map(function(n){return[ol.offsetLeft+n.offsetLeft+n.offsetWidth/2,ol.offsetTop+n.offsetTop+n.offsetHeight/2];});var d="M"+pts[0][0]+" "+pts[0][1],seg=[0];for(var i=1;i<pts.length;i++){var x0=pts[i-1][0],y0=pts[i-1][1],x1=pts[i][0],y1=pts[i][1],s;if(Math.abs(x1-x0)>=Math.abs(y1-y0)){var mx=(x0+x1)/2;s="C"+mx+" "+y0+" "+mx+" "+y1+" "+x1+" "+y1;}
else{var my=(y0+y1)/2;s="C"+x0+" "+my+" "+x1+" "+my+" "+x1+" "+y1;}
var t=document.createElementNS("http://www.w3.org/2000/svg","path");t.setAttribute("d","M"+x0+" "+y0+" "+s);svg.appendChild(t);seg.push(seg[i-1]+t.getTotalLength());svg.removeChild(t);d+=" "+s;}
base.setAttribute("d",d);prog.setAttribute("d",d);len=prog.getTotalLength();fr=seg.map(function(v){return v/seg[seg.length-1];});prog.style.strokeDasharray=len;draw(fr[at]||0);}
function draw(f){cur=f;prog.style.strokeDashoffset=len*(1-f);var p=prog.getPointAtLength(len*f);dot.setAttribute("cx",p.x);dot.setAttribute("cy",p.y);}
function glide(to,ms){cancelAnimationFrame(raf);if(calm||ms===0){draw(to);return;}
var from=cur,t0=null;(function step(t){t0=t0||t;var k=Math.min((t-t0)/ms,1),e=1-Math.pow(1-k,3);draw(from+(to-from)*e);if(k<1)raf=requestAnimationFrame(step);})(performance.now());}
function paint(i,jump){at=i;roles.forEach(function(r,k){r.classList.toggle("on",k===i);lis[k].classList.toggle("reached",k<=i);});glide(fr[i]||0,jump?0:900);}
function tick(){clearTimeout(timer);if(calm||hold)return;timer=setTimeout(function(){var n=(at+1)%roles.length;paint(n,n===0);tick();},at===roles.length-1?3200:2200);}
roles.forEach(function(r,k){["pointerenter","focus"].forEach(function(ev){r.addEventListener(ev,function(){hold=true;clearTimeout(timer);paint(k);});});});["pointerleave","focusout"].forEach(function(ev){path.addEventListener(ev,function(){hold=false;tick();});});layout();paint(calm?roles.length-1:0,true);addEventListener("resize",function(){layout();});if(document.fonts&&document.fonts.ready)document.fonts.ready.then(layout);if("IntersectionObserver"in window&&!calm){new IntersectionObserver(function(es,o){if(es[0].isIntersecting){path.classList.add("in");o.disconnect();setTimeout(layout,120);tick();}},{threshold:.3}).observe(path);}else{path.classList.add("in");}
var tabsEl=document.getElementById("jr-tabs"),glider=tabsEl.querySelector(".jr-glider");var tabs=[].slice.call(tabsEl.querySelectorAll(".jr-tab")),panels=[].slice.call(root.querySelectorAll(".jr-panel"));function slide(){var t=tabs.filter(function(x){return x.classList.contains("on");})[0];if(!t)return;glider.style.setProperty("--x",t.offsetLeft+"px");glider.style.setProperty("--y",t.offsetTop+"px");glider.style.setProperty("--w",t.offsetWidth+"px");glider.style.setProperty("--h",t.offsetHeight+"px");}
tabs.forEach(function(b){b.addEventListener("click",function(){tabs.forEach(function(x){var on=x===b;x.classList.toggle("on",on);x.setAttribute("aria-selected",on);});panels.forEach(function(p){var show=p.dataset.p===b.dataset.p;p.hidden=!show;if(show){p.classList.remove("swap");void p.offsetWidth;p.classList.add("swap");}});slide();});});addEventListener("resize",slide);slide();if(document.fonts&&document.fonts.ready)document.fonts.ready.then(slide);})();</script><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel=stylesheet><link href="/css/home-selfpaced.css?v=tDeOxf-1MkknWa4TMeFTe5UWjHdA0lIreXsaLtip0O0" rel=stylesheet><section class=lt id=self-paced aria-labelledby=lt-title><div class=lt-shell><header class=lt-head><h2 id=lt-title>Build skills that <em>stay useful</em></h2><p>Self-paced courses with videos, labs, skill tests and quick notes. Learn at your own time, with 2 years of access.</header><div class=lt-pillbar><div class=lt-pills id=lt-pills role=tablist aria-label="Course categories"><span class=lt-glider aria-hidden=true></span> <button type=button role=tab class="lt-pill on" data-filter=34 aria-selected=true><span>.NET Platform </span><small>5</small></button> <button type=button role=tab class=lt-pill data-filter=77 aria-selected=false><span>AI/ML</span><small>4</small></button> <button type=button role=tab class=lt-pill data-filter=78 aria-selected=false><span>Career &amp; Leadership</span><small>1</small></button> <button type=button role=tab class=lt-pill data-filter=37 aria-selected=false><span>Cloud &amp; DevOps </span><small>4</small></button> <button type=button role=tab class=lt-pill data-filter=33 aria-selected=false><span>Databases</span><small>2</small></button> <button type=button role=tab class=lt-pill data-filter=79 aria-selected=false><span>Java Platform</span><small>3</small></button> <button type=button role=tab class=lt-pill data-filter=36 aria-selected=false><span>JS