height=22 loading=lazy><li><img class=al-logo src=/images/companies/tcs.png alt="" title=TCS style=--h:44px height=44 loading=lazy><li><img class=al-logo src=/images/companies/infosys.png alt="" title=Infosys style=--h:26px height=26 loading=lazy><li><img class=al-logo src=/images/companies/techm.png alt="" title="Tech Mahindra" style=--h:26px height=26 loading=lazy><li><img class=al-logo src=/images/companies/paytm.png alt="" title=Paytm style=--h:26px height=26 loading=lazy></ul></div></div></div></section></section><script>(function(){var root=document.getElementById("home-hero");if(!root)return;var calm=matchMedia("(prefers-reduced-motion: reduce)").matches;var tabs=[].slice.call(root.querySelectorAll(".hh-tab")),scenes=[].slice.call(root.querySelectorAll(".hh-scene")),floats=[].slice.call(root.querySelectorAll("#hh-float .f"));var glider=root.querySelector(".hh-glider"),stage=document.getElementById("hh-stage"),cur=0,timer=null,paused=false,visible=true,DUR=5600;function place(){var t=tabs[cur];glider.style.setProperty("--x",t.offsetLeft+"px");glider.style.setProperty("--w",t.offsetWidth+"px");}
function show(i){cur=(i+tabs.length)%tabs.length;tabs.forEach(function(t,k){var on=k===cur;t.classList.toggle("on",on);t.setAttribute("aria-selected",on);t.classList.remove("run");});scenes.forEach(function(s,k){s.classList.toggle("on",k===cur);});floats.forEach(function(f,k){f.classList.toggle("on",k===cur);});place();void tabs[cur].offsetWidth;if(!calm)tabs[cur].classList.add("run");arm();}
function arm(){clearTimeout(timer);if(calm||paused||!visible)return;timer=setTimeout(function(){show(cur+1);},DUR);}
tabs.forEach(function(t){t.addEventListener("click",function(){show(+t.dataset.i);});});stage.addEventListener("pointerenter",function(){paused=true;clearTimeout(timer);stage.classList.add("hold");});stage.addEventListener("pointerleave",function(){paused=false;stage.classList.remove("hold");show(cur);});stage.addEventListener("focusin",function(){paused=true;clearTimeout(timer);stage.classList.add("hold");});stage.addEventListener("focusout",function(){paused=false;stage.classList.remove("hold");show(cur);});if("IntersectionObserver"in window)new IntersectionObserver(function(e){visible=e[0].isIntersecting;visible?show(cur):clearTimeout(timer);}).observe(stage);addEventListener("resize",place);place();if(!calm){tabs[0].classList.add("run");arm();}
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(place);if(!calm&&matchMedia("(hover: hover) and (pointer: fine)").matches){var q=false,px=0,py=0;stage.addEventListener("pointermove",function(e){var r=stage.getBoundingClientRect();px=(e.clientX-r.left)/r.width-.5;py=(e.clientY-r.top)/r.height-.5;if(q)return;q=true;requestAnimationFrame(function(){q=false;stage.style.setProperty("--ry",(px*5).toFixed(2)+"deg");stage.style.setProperty("--rx",(-py*4).toFixed(2)+"deg");stage.style.setProperty("--tx",(px*14).toFixed(1)+"px");stage.style.setProperty("--ty",(py*10).toFixed(1)+"px");});},{passive:true});stage.addEventListener("pointerleave",function(){["--ry","--rx","--tx","--ty"].forEach(function(v){stage.style.removeProperty(v);});});}
var nums=[].slice.call(root.querySelectorAll("[data-count]"));function run(el){var to=+el.dataset.count,suf=el.dataset.suffix||"",t0=null;if(calm){el.textContent=to+suf;return;}
(function step(t){t0=t0||t;var p=Math.min((t-t0)/1200,1),v=Math.round(to*(1-Math.pow(1-p,3)));el.textContent=v+suf;if(p<1)requestAnimationFrame(step);})(performance.now());}
if("IntersectionObserver"in window){var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){run(x.target);io.unobserve(x.target);}});},{threshold:.6});nums.forEach(function(n){io.observe(n);});}})();</script><link rel=stylesheet href="/styles/job-oriented-display.css?v=rZc98XFkJmv5gXqa-CQ-ylXjpFsIYlziIgdgNpLbftM"><link rel=stylesheet href="/css/home-bootcamps.css?v=rwcw_n9nXYKiWUZDzYBcOfcE0uvCKHOQ-HPp7vRYIk4"><section class="job-section jr" id=job-roadmap aria-labelledby=jr-title><div class=job-glow-1 aria-hidden=true></div><div class=job-glow-2 aria-hidden=true></div><div class=jr-shell><header class=jr-head><h2 id=jr-title>Where our bootcamps <em>take you</em></h2><p>Pick a bootcamp, build real skills, and grow into the roles companies hire for.</header><div class=jr-path id=jr-path><svg class=jr-wave aria-hidden=true focusable=false><path class=base></path><path class=prog></path><circle class=dot r=5></circle></svg><ol class=jr-nodes aria-label="Career roadmap"><li style=--i:0><span class=jr-node><i class="bi bi-code-slash" aria-hidden=true></i></span> <button type=button class=jr-role data-i=0><b>Full-Stack Developer</b><small>Build production web apps end to end.</small></button><li style=--i:1><span class=jr-node><i class="bi bi-cpu-fill" aria-hidden=true></i></span> <button type=button class=jr-role data-i=1><b>AI Engineer</b><small>Ship machine learning and LLM features.</small></button><li style=--i:2><span class=jr-node><i class="bi bi-cloud-fill" aria-hidden=true></i></span> <button type=button class=jr-role data-i=2><b>Cloud &amp; DevOps Engineer</b><small>Automate and run systems in the cloud.</small></button><li style=--i:3><span class=jr-node><i class="bi bi-stars" aria-hidden=true></i></span> <button type=button class=jr-role data-i=3><b>Generative AI &amp; AI Agent Engineer</b><small>Design RAG and multi-agent apps.</small></button><li style=--i:4><span class=jr-node><i class="bi bi-diagram-3-fill" aria-hidden=true></i></span> <button type=button class=jr-role data-i=4><b>Solution Architect</b><small>Design systems that scale.</small></button><li style=--i:5><span class=jr-node><i class="bi bi-buildings-fill" aria-hidden=true></i></span> <button type=button class=jr-role data-i=5><b>Enterprise Architect</b><small>Align technology with the business.</small></button><li style=--i:6><span class=jr-node><i class="bi bi-trophy-fill" aria-hidden=true></i></span> <button type=button class=jr-role data-i=6><b>Chief Technology Officer (CTO)</b><small>Lead engineering and technology.</small></button></ol></div><div class=jr-explore><aside class=jr-cats aria-label="Bootcamp tracks"><p class=jr-cats__label>Choose your track<div class=jr-tabs id=jr-tabs role=tablist aria-label="Bootcamp categories"><span class=jr-glider aria-hidden=true></span> <button type=button role=tab class="jr-tab on" data-p=0 aria-selected=true><span>.NET</span><small>3</small><i class="bi bi-arrow-right jr-tab__go" aria-hidden=true></i></button> <button type=button role=tab class=jr-tab data-p=1 aria-selected=false><span>AI/ML</span><small>2</small><i class="bi bi-arrow-right jr-tab__go" aria-hidden=true></i></button> <button type=button role=tab class=jr-tab data-p=2 aria-selected=false><span>Java</span><small>2</small><i class="bi bi-arrow-right jr-tab__go" aria-hidden=true></i></button> <button type=button role=tab class=jr-tab data-p=3 aria-selected=false><span>JavaScript</span><small>1</small><i class="bi bi-arrow-right jr-tab__go" aria-hidden=true></i></button></div></aside><div class=jr-panels><div class=jr-panel data-p=0 role=tabpanel><div class=jr-grid><a class=jr-card href=/bootcamp/net-ai-ml-architect-bootcamp style=--k:0 title="Get more details about .NET AI/ML Architect Bootcamp"> <span class=jr-poster><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/CourseImages/netaimlarchitectbootcamp-small.png alt="" width=400 height=200 loading=lazy></span> <span class=jr-body> <span class=jr-cat>.