elongs to the Fibonacci Sequence</span> <svg class=fr-ico aria-hidden=true><use href=#fr-i-chev /></svg> </a> <a class=fr-prob href=/problems/dsa/find-the-nth-fibonacci-number-efficiently> <span class="fr-diff fr-diff--easy">Basic</span> <span class=fr-prob__name>Find the Nth Fibonacci Number Efficiently</span> <svg class=fr-ico aria-hidden=true><use href=#fr-i-chev /></svg> </a> <a class=fr-prob href=/problems/dsa/generate-fibonacci-numbers-up-to-a-limit> <span class="fr-diff fr-diff--easy">Basic</span> <span class=fr-prob__name>Generate Fibonacci Numbers up to a Limit</span> <svg class=fr-ico aria-hidden=true><use href=#fr-i-chev /></svg> </a></div></div><a class=fr-all href=/problems>View all problems <svg class=fr-ico aria-hidden=true><use href=#fr-i-arrow /></svg></a></div></div></div></div></section><script>(function(){var root=document.getElementById("free-resources");if(!root)return;var calm=window.matchMedia("(prefers-reduced-motion: reduce)").matches;var list=root.querySelector("#fr-tabs"),tabs=[].slice.call(list.querySelectorAll(".fr-tab")),glider=list.querySelector(".fr-glider");var tickT;function live(p){clearInterval(tickT);var n=p.querySelector(".fr-num"),tk=p.querySelector(".fr-ticker span");if(n&&!calm){var to=+n.dataset.to,t0=null;(function step(t){t0=t0||t;var k=Math.min((t-t0)/1000,1);n.textContent=Math.round(to*(1-Math.pow(1-k,3)));if(k<1)requestAnimationFrame(step);})(performance.now());}
if(tk&&!calm){var names=[];try{names=JSON.parse(tk.dataset.names||"[]");}catch(e){}
var i=0;if(names.length>1)tickT=setInterval(function(){tk.classList.add("out");setTimeout(function(){i=(i+1)%names.length;tk.textContent=names[i];tk.classList.remove("out");},260);},2400);}}
function glide(t){glider.style.setProperty("--x",t.offsetLeft+"px");glider.style.setProperty("--w",t.offsetWidth+"px");glider.style.setProperty("--y",t.offsetTop+"px");glider.style.setProperty("--h",t.offsetHeight+"px");}
