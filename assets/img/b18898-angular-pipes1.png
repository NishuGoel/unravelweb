id=mc-next aria-label="Next master class"><i class="bi bi-arrow-right" aria-hidden=true></i></button></div></div></div></div></section><script>(function(){var root=document.getElementById("master-classes");if(!root)return;var calm=matchMedia("(prefers-reduced-motion: reduce)").matches;var counts=[].slice.call(root.querySelectorAll(".mc-count"));function pad(n){return n<10?"0"+n:n;}
function tick(){counts.forEach(function(c){var t=new Date(c.dataset.ts).getTime(),out=c.querySelector("span");if(isNaN(t))return;var d=t-Date.now();if(d<=0){out.textContent=new Date(t).toDateString()===new Date().toDateString()?"Happening today":"Starting now";return;}
var days=Math.floor(d/864e5),h=Math.floor(d%864e5/36e5),m=Math.floor(d%36e5/6e4),s=Math.floor(d%6e4/1e3);out.textContent="Starts in "+(days>0?days+"d ":"")+pad(h)+"h "+pad(m)+"m"+(days===0?" "+pad(s)+"s":"");});}
tick();if(!calm&&counts.length)setInterval(tick,1000);var slides=[].slice.call(root.querySelectorAll(".mc-feature")),dots=[].slice.call(root.querySelectorAll(".mc-dot"));var stage=document.getElementById("mc-stage"),cur=0,timer,paused=false,visible=true,DUR=5500;function show(i){cur=(i+slides.length)%slides.length;slides.forEach(function(s,k){var on=k===cur;s.classList.toggle("on",on);s.tabIndex=on?0:-1;});dots.forEach(function(d,k){var on=k===cur;d.classList.toggle("on",on);d.setAttribute("aria-selected",on);d.classList.remove("run");});if(dots[cur]){void dots[cur].offsetWidth;if(!calm)dots[cur].classList.add("run");dots[cur].parentNode.scrollTo({left:dots[cur].offsetLeft-8,behavior:calm?"auto":"smooth"});}
arm();}
function arm(){clearTimeout(timer);if(calm||paused||!visible||slides.length<2)return;timer=setTimeout(function(){show(cur+1);},DUR);}
if(slides.length>1){dots.forEach(function(d){d.addEventListener("click",function(){show(+d.dataset.i);});});var pv=document.getElementById("mc-prev"),nx=document.getElementById("mc-next");if(pv)pv.addEventListener("click",function(){show(cur-1);});if(nx)nx.addEventListener("click",function(){show(cur+1);});stage.addEventListener("pointerenter",function(){paused=true;clearTimeout(timer);stage.classList.add("hold");});stage.addEventListener("pointerleave",function(){paused=false;stage.classList.remove("hold");arm();});stage.addEventListener("focusin",function(){paused=true;clearTimeout(timer);stage.classList.add("hold");});stage.addEventListener("focusout",function(){paused=false;stage.classList.remove("hold");arm();});if("IntersectionObserver"in window)new IntersectionObserver(function(es){visible=es[0].isIntersecting;visible?arm():clearTimeout(timer);}).observe(stage);if(!calm&&dots[0])dots[0].classList.add("run");arm();}
if(!calm&&"IntersectionObserver"in window){root.classList.add("js-in");new IntersectionObserver(function(es,o){if(es[0].isIntersecting){root.classList.add("in");o.disconnect();}},{threshold:.2}).observe(root);}else{root.classList.add("in");}
if(!calm&&matchMedia("(hover: hover) and (pointer: fine)").matches){slides.forEach(function(f){f.addEventListener("pointermove",function(e){var r=f.getBoundingClientRect();f.style.setProperty("--mx",(e.clientX-r.left)+"px");f.style.setProperty("--my",(e.clientY-r.top)+"px");},{passive:true});});}})();</script><link href=https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css rel=stylesheet><link href=https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css rel=stylesheet><link rel=stylesheet href=https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel=stylesheet><link rel=stylesheet href="/css/home-testimonials.css?v=dsBgBHoX2ZvjMOQj2vVU52drwlU1K4FWu6kMsGwaVaA"><section id=testimonial class=tm aria-labelledby=tm-title><div class=tm-shell><header class=tm-head><h2 id=tm-title>Learners who <em>made the switch</em></h2><p class=tm-score aria-label="Average rating 4.7 out of 5 from 5 learner reviews"><b>4.7 Average Reviews</b> <span class=tm-stars aria-hidden=true> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-half"></i> </span></header><div class=tm-viewport id=tm-viewport><div class=tm-track id=tm-track tabindex=0 aria-label="Learner reviews"><button type=button class=tm-vid data-video=4OUVQ5RkzmE aria-label="Watch a student story"> <img src=https://img.youtube.com/vi/4OUVQ5RkzmE/hqdefault.jpg alt="" loading=lazy> <span class=tm-vid__play><i class="bi bi-play-fill" aria-hidden=true></i></span> <span class=tm-vid__cap><b>Watch</b><small>Student story</small></span> </button><article class=tm-card style=--k:0><span class=tm-card__n aria-hidden=true>01</span><p class=tm-rate aria-label="Rated 4.50 out of 5"><span class=tm-stars aria-hidden=true> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-half"></i> </span><blockquote class=tm-quote>I have taken class from Scholarhat it exceptionally changed my mind set and approach about development I can say that after getting training from Scholarhat I&#x2019;m very much confident about my work whatever I&#x2019;m doing because now I&#x2019;m knowing what, where and how to implement things in my project, thanks Scholarhat for giving me in depth skills.</blockquote><div class=tm-who><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/testimonialImages/920180811060439.png alt="Parmanand Kumar" width=44 height=44 loading=lazy> <span class=tm-who__t><b>Parmanand Kumar</b><small>Software Engineer </small></span> <a href=https://www.facebook.com/parmanandk2 target=_blank rel="nofollow noopener" class=tm-who__link aria-label="Parmanand Kumar on social media"><i class="bi bi-facebook" aria-hidden=true></i></a></div></article><article class=tm-card style=--k:1><span class=tm-card__n aria-hidden=true>02</span><p class=tm-rate aria-label="Rated 4.50 out of 5"><span class=tm-stars aria-hidden=true> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-half"></i> </span><blockquote class=tm-quote>I have gone through Scholarhat blogs many times for learning AngularJS from that time, I was waiting for AngularJS training batch. I was confused before the training because I wanted to get training on real time project which they have delivered according to my expectation now I&#x2019;m so much confident about AngularJS development.</blockquote><div class=tm-who><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/testimonialImages/920180811060428.png alt="vibhu mishra" width=44 height=44 loading=lazy> <span class=tm-who__t><b>vibhu mishra</b><small>Software Programmer</small></span> <a href=https://in.linkedin.com/in/vibhu-mishra-07532236 target=_blank rel="nofollow noopener" class=tm-who__link aria-label="vibhu mishra on social media"><i class="bi bi-linkedin" aria-hidden=true></i></a></div></article><article class=tm-card style=--k:2><span class=tm-card__n aria-hidden=true>03</span><p class=tm-rate aria-label="Rated 5.00 out of 5"><span class=tm-stars aria-hidden=true> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> </span><blockquote class=tm-quote>Scholarhat is a good training institute for learning real time projects. Our knowledge today does not have much value beyond a couple of years. Your value is what you can learn and how easily you can adapt to the changes this profession brings so often. Mr. Shailendra always teaches latest technologies. So, I found its worth to learn in Scholarhat and coding actually becomes rhyme.</blockquote><div class=tm-who><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/testimonialImages/920180811081123.png alt="Manju Lata Yadav" width=44 height=44 loading=lazy> <span class=tm-who__t><b>Manju Lata Yadav</b><small>Software Professional</small></span> <a href="https://www.linkedin.com/in/manju-lata-yadav-b6522a80?authType=NAME_SEARCH&amp;authToken=F320&amp;locale=en_US&amp;trk=tyah&amp;trkInfo=clickedVertical%3Amynetwork%2CclickedEntityId%3A287212541%2CauthType%3ANAME_SEARCH%2Cidx%3A1-1-1%2CtarId%3A1467108200585%2Ctas%3Amanju%20lata%20yadav" target=_blank rel="nofollow noopener" class=tm-who__link aria-label="Manju Lata Yadav on social media"><i class="bi bi-linkedin" aria-hidden=true></i></a></div></article><article class=tm-card style=--k:3><span class=tm-card__n aria-hidden=true>04</span><p class=tm-rate aria-label="Rated 5.00 out of 5"><span class=tm-stars aria-hidden=true> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> </span><blockquote class=tm-quote>Scholarhat is a good training company for real time Software Development. I have taken training over MVC Development with AgularJs. Mr. Shailendra Sir always teaches latest technologies. So, I found its worth to learn in Scholarhat and coding actually becomes rhyme.</blockquote><div class=tm-who><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/testimonialImages/920180811081146.png alt="Ajeet Singh" width=44 height=44 loading=lazy> <span class=tm-who__t><b>Ajeet Singh</b><small>Software Developer</small></span> <a href=https://en-gb.facebook.com/people/Ajeet-Singh/100002466853427 target=_blank rel="nofollow noopener" class=tm-who__link aria-label="Ajeet Singh on social media"><i class="bi bi-facebook" aria-hidden=true></i></a></div></article><article class=tm-card style=--k:4><span class=tm-card__n aria-hidden=true>05</span><p class=tm-rate aria-label="Rated 4.50 out of 5"><span class=tm-stars aria-hidden=true> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-fill"></i> <i class="bi bi-star-half"></i> </span><blockquote class=tm-quote>I am Pushpendra Singh, Managing Director of Techsan India Technologies Pvt. Ltd. I am truly impressed with the quality of development training delivered by ScholarHat and their continued commitment to building strong and creative career paths for students. I highly recommend ScholarHat for Java and Spring Boot training. He is highly skilled, intuitive, dedicated, and genuinely cares about his students&#x2019; growth. His training approach is always aligned with the latest technologies and real-world industry requirements.</blockquote><div class=tm-who><img src=https://dotnettrickscloud.blob.core.windows.net/uploads/testimonialImages/920180811081204.png alt="Puspendra Singh" width=44 height=44 loading=lazy> <span class=tm-who__t><b>Puspendra Singh</b><small>Managing Director </small></span> <a href="https://in.linkedin.com/in/pushpendra1?trk=pub-pbmap" target=_blank rel="nofollow noopener" class=tm-who__link aria-label="Puspendra Singh on social media"><i class="bi bi-linkedin" aria-hidden=true></i></a></div></article></div></div><div class=tm-nav><div class=tm-bar aria-hidden=true><i id=tm-bar></i></div><div class=tm-nav__r><a href=/reviews class=tm-all>View all reviews <i class="bi bi-arrow-up-right" aria-hidden=true></i></a><div class=tm-arrows><button type=button class=tm-arrow id=tm-prev aria-label="Previous reviews"><i class="bi bi-arrow-left" aria-hidden=true></i></button> <button type=button class=tm-arrow id=tm-next aria-label="Next reviews"><i class="bi bi-arrow-right" aria-hidden=true></i></button></div></div></div></div></section><dialog class=tm-dlg id=tm-dlg aria-label="Student story video"><button type=button class=tm-dlg__x id=tm-dlg-x aria-label="Close video"><i class="bi bi-x-lg" aria-hidden=true></i></button><div class=tm-dlg__frame><iframe id=tm-dlg-f title="Student story" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div></dialog><script src=https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.2.1/owl.carousel.min.js></script><script>(function(){var root=document.getElementById("testimonial");if(!root)return;var calm=matchMedia("(prefers-reduced-motion: reduce)").matches;var track=document.getElementById("tm-track"),bar=document.getElementById("tm-bar");var prev=document.getElementById("tm-prev"),next=document.getElementById("tm-next");var cards=[].slice.call(track.querySelectorAll(".tm-card")),timer,paused=false,visible=true;var vid=track.querySelector(".tm-vid"),dlg=document.getElementById("tm-dlg"),frame=document.getElementById("tm-dlg-f");if(vid&&dlg&&dlg.showModal){vid.addEventListener("click",function(){frame.src="https://www.youtube.com/embed/"+vid.dataset.video+"?autoplay=1&modestbranding=1&rel=0&playsinline=1";dlg.showModal();});document.getElementById("tm-dlg-x").addEventListener("click",function(){dlg.close();});dlg.addEventListener("click",function(e){if(e.target===dlg)dlg.close();});dlg.addEventListener("close",function(){frame.src="about:blank";});}else if(vid){vid.addEventListener("click",function(){window.open("https://www.youtube.com/watch?v="+vid.dataset.video,"_blank","noopener");});}
function step(){var c=cards[0];return c?c.getBoundingClientRect().width+18:track.clientWidth;}
function progress(){var max=track.scrollWidth-track.clientWidth;bar.style.transform="scaleX("+(max>0?Math.max(.08,track.scrollLeft/max):1)+")";prev.disabled=track.scrollLeft<6;next.disabled=track.scrollLeft>=max-6;}
function go(dir){var max=track.scrollWidth-track.clientWidth;if(dir>0&&track.scrollLeft>=max-6)track.scrollTo({left:0,behavior:calm?"auto":"smooth"});else track.scrollBy({left:dir*step(),behavior:calm?"auto":"smooth"});}
prev.addEventListener("click",function(){go(-1);arm();});next.addEventListener("click",function(){go(1);arm();});track.addEventListener("scroll",function(){requestAnimationFrame(progress);},{passive:true});addEventListener("resize",progress);progress();function arm(){clearInterval(timer);if(calm||paused||!visible)return;timer=setInterval(function(){go(1);},5200);}
["pointerenter","focusin","touchstart"].forEach(function(e){root.addEventListener(e,function(){paused=true;clearInterval(timer);},{passive:true});});["pointerleave","focusout"].forEach(function(e){root.addEventListener(e,function(){paused=false;arm();});});if("IntersectionObserver"in window)new IntersectionObserver(function(es){visible=es[0].isIntersecting;visible?arm():clearInterval(timer);}).observe(root);arm();if(!calm&&"IntersectionObserver"in window){root.classList.add("js-in");new IntersectionObserver(function(es,o){if(es[0].isIntersecting){root.classList.add("in");o.disconnect();}},{threshold:.15}).observe(root);}else{root.classList.add("in");}
