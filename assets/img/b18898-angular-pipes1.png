ipt>(function(){var root=document.getElementById('mcOffers');if(!root)return;var key='mcOffersClosed',sig=root.getAttribute('data-sig');try{if(sessionStorage.getItem(key)===sig){root.remove();return;}}catch(e){}
var calm=matchMedia('(prefers-reduced-motion: reduce)').matches;var slides=[].slice.call(root.querySelectorAll('.mc-offer')),dots=[].slice.call(root.querySelectorAll('.mc-offers__dot'));var cur=0,timer=null,paused=false;function ends(el){var v=el.getAttribute('data-end');return v?new Date(v+'+05:30').getTime():0;}
function live(){return slides.filter(function(s){return!s.hidden;});}
function fit(s){var box=s.querySelector('.mc-offer__text'),txt=box.firstElementChild;txt.style.removeProperty('--shift');box.classList.remove('is-scroll');var over=txt.scrollWidth-box.clientWidth;if(over>2&&!calm){txt.style.setProperty('--shift','-'+(over+8)+'px');txt.style.setProperty('--dur',Math.max(6,over/40)+'s');box.classList.add('is-scroll');}}
function show(i){var l=live();if(!l.length){root.remove();return;}
cur=(i+l.length)%l.length;slides.forEach(function(s){var on=s===l[cur];s.classList.toggle('is-on',on);s.setAttribute('aria-hidden',on?'false':'true');s.tabIndex=on?0:-1;});dots.forEach(function(d,k){d.hidden=k>=l.length;d.classList.toggle('is-on',k===cur);});fit(l[cur]);}
function arm(){clearInterval(timer);if(calm||live().length<2)return;timer=setInterval(function(){if(!paused&&!document.hidden)show(cur+1);},6500);}
root.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;if(b.classList.contains('mc-offers__close')){try{sessionStorage.setItem(key,sig);}catch(x){}
root.classList.add('is-closing');setTimeout(function(){root.remove();},260);return;}
if(b.hasAttribute('data-dir'))show(cur+parseInt(b.getAttribute('data-dir'),10));else if(b.hasAttribute('data-go'))show(parseInt(b.getAttribute('data-go'),10));arm();});root.addEventListener('mouseenter',function(){paused=true;});root.addEventListener('mouseleave',function(){paused=false;});root.addEventListener('focusin',function(){paused=true;});root.addEventListener('focusout',function(){paused=false;});root.addEventListener('keydown',function(e){if(e.key==='ArrowLeft'){show(cur-1);arm();}if(e.key==='ArrowRight'){show(cur+1);arm();}});var x0=null;root.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;},{passive:true});root.addEventListener('touchend',function(e){if(x0===null)return;var dx=e.changedTouches[0].clientX-x0;x0=null;if(Math.abs(dx)>40){show(cur+(dx<0?1:-1));arm();}},{passive:true});function tick(){var now=Date.now(),gone=false;slides.forEach(function(s){var t=ends(s);if(!t||s.hidden)return;var d=t-now;if(d<=0){s.hidden=true;gone=true;return;}
var v={d:Math.floor(d/864e5),h:Math.floor(d%864e5/36e5),m:Math.floor(d%36e5/6e4),s:Math.floor(d%6e4/1e3)};for(var k in v){var el=s.querySelector('[data-u="'+k+'"]');if(el)el.textContent=String(v[k]).padStart(2,'0');}});if(gone){show(0);arm();}}
