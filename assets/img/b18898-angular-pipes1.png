const getStoredTheme=()=>localStorage.getItem('theme');const setStoredTheme=theme=>localStorage.setItem('theme',theme);const getPreferredTheme=()=>{const storedTheme=getStoredTheme();if(storedTheme){return storedTheme;}
return'light';}
